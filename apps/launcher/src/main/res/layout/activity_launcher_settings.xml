<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS 18 2-Column Settings Layout:
     Left: Navigation Sidebar with Glass Categories.
     Right: Dynamic Glass Content Panes.
     Overlay: Native Liquid Glass Modal Dialog. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_backdrop">

    <!-- Main 2-Column Settings UI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <!-- Top Title Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="52dp"
            android:paddingEnd="52dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/launcher_settings"
                android:textColor="@color/tvos_label_primary"
                android:textSize="26sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/settingsCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/pill_bg"
                android:text="@string/tab_appearance"
                android:textColor="@color/tvos_label_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 2-Column Workspace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="52dp"
            android:paddingEnd="52dp">

            <!-- LEFT COLUMN: Categories Sidebar (35%) -->
            <LinearLayout
                android:id="@+id/leftCategoriesSidebar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.32"
                android:layout_marginEnd="28dp"
                android:padding="16dp"
                android:background="@drawable/settings_glass_card"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsGroupLabel"
                    android:layout_marginBottom="12dp"
                    android:text="SETTINGS" />

                <TextView
                    android:id="@+id/tabAppearance"
                    style="@style/SettingsTabItem"
                    android:text="@string/tab_appearance" />

                <TextView
                    android:id="@+id/tabDisplayNight"
                    style="@style/SettingsTabItem"
                    android:text="@string/tab_display_night" />

                <TextView
                    android:id="@+id/tabRemotes"
                    style="@style/SettingsTabItem"
                    android:text="@string/tab_remotes" />

                <TextView
                    android:id="@+id/tabAppsSystem"
                    style="@style/SettingsTabItem"
                    android:text="@string/tab_apps_system" />
            </LinearLayout>

            <!-- RIGHT COLUMN: Detail Pane (65%) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.68"
                android:padding="24dp"
                android:background="@drawable/settings_glass_card">

                <!-- PANE 1: Appearance -->
                <ScrollView
                    android:id="@+id/paneAppearance"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsGroupLabel"
                            android:text="@string/columns_label" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="20dp"
                            android:orientation="horizontal">

                            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
                        </LinearLayout>

                        <TextView
                            style="@style/SettingsGroupLabel"
                            android:text="MOTION &amp; EFFECTS" />

                        <TextView
                            android:id="@+id/animationsChoice"
                            style="@style/SettingsRow"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/advancedChoice"
                            style="@style/SettingsRow"
                            android:layout_marginTop="8dp" />

                        <TextView
                            style="@style/SettingsFootnote"
                            android:layout_marginTop="6dp"
                            android:text="@string/advanced_effects_warning" />

                        <TextView
                            android:id="@+id/followThemeChoice"
                            style="@style/SettingsRow"
                            android:layout_marginTop="20dp" />
                    </LinearLayout>
                </ScrollView>

                <!-- PANE 2: Display & Night Dimmer & Screensaver -->
                <ScrollView
                    android:id="@+id/paneDisplayNight"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/displaySettingsContents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- SECTION 1: SCREENSAVER -->
                        <TextView
                            style="@style/SettingsGroupLabel"
                            android:text="@string/screensaver_header" />

                        <TextView
                            style="@style/SettingsGroupLabel"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/tvos_label_tertiary"
                            android:text="@string/screensaver_type_label" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="16dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/screensaverModeContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView android:id="@+id/screensaverModeOff" style="@style/SettingsColumnChoice" android:text="@string/off" />
                                <TextView android:id="@+id/screensaverModeWallpapers" style="@style/SettingsColumnChoice" android:text="@string/screensaver_wallpapers" />
                            </LinearLayout>
                        </HorizontalScrollView>

                        <TextView
                            style="@style/SettingsGroupLabel"
                            android:textColor="@color/tvos_label_tertiary"
                            android:text="@string/screensaver_timeout_label" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="16dp"
                            android:orientation="horizontal">

                            <TextView android:id="@+id/screensaverTimeout0" style="@style/SettingsColumnChoice" android:text="@string/off" />
                            <TextView android:id="@+id/screensaverTimeout2" style="@style/SettingsColumnChoice" android:text="2 min" />
                            <TextView android:id="@+id/screensaverTimeout5" style="@style/SettingsColumnChoice" android:text="5 min" />
                            <TextView android:id="@+id/screensaverTimeout10" style="@style/SettingsColumnChoice" android:text="10 min" />
                            <TextView android:id="@+id/screensaverTimeout15" style="@style/SettingsColumnChoice" android:layout_marginEnd="0dp" android:text="15 min" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/screensaverOverlayChoice"
                            style="@style/SettingsRow"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="28dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/screensaverPreviewChoice"
                                style="@style/SettingsColumnChoice"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/screensaver_preview" />

                            <TextView
                                android:id="@+id/screensaverSystemSettingsChoice"
                                style="@style/SettingsColumnChoice"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="0dp"
                                android:text="@string/screensaver_system_settings" />
                        </LinearLayout>

                        <!-- SECTION 2: NIGHT DIMMER -->
                        <TextView
                            style="@style/SettingsGroupLabel"
                            android:text="@string/dimmer_mode_label" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="16dp"
                            android:orientation="horizontal">

                            <TextView android:id="@+id/dimmerModeOff" style="@style/SettingsColumnChoice" android:text="@string/dimmer_mode_off" />
                            <TextView android:id="@+id/dimmerModeScheduled" style="@style/SettingsColumnChoice" android:text="@string/dimmer_mode_scheduled" />
                            <TextView android:id="@+id/dimmerModeAlways" style="@style/SettingsColumnChoice" android:layout_marginEnd="0dp" android:text="@string/dimmer_mode_always_on" />
                        </LinearLayout>

                        <TextView
                            style="@style/SettingsGroupLabel"
                            android:textColor="@color/tvos_label_tertiary"
                            android:text="@string/dimmer_level_label" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">

                            <TextView android:id="@+id/dimmerLevel25" style="@style/SettingsColumnChoice" android:text="25%" />
                            <TextView android:id="@+id/dimmerLevel50" style="@style/SettingsColumnChoice" android:text="50%" />
                            <TextView android:id="@+id/dimmerLevel70" style="@style/SettingsColumnChoice" android:layout_marginEnd="0dp" android:text="70%" />
                        </LinearLayout>

                        <TextView
                            style="@style/SettingsFootnote"
                            android:text="@string/dimmer_footnote" />
                    </LinearLayout>
                </ScrollView>

                <!-- PANE 3: Remotes & Buttons -->
                <ScrollView
                    android:id="@+id/paneRemotes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsGroupLabel"
                            android:text="@string/remote_key_mapper" />

                        <TextView
                            android:id="@+id/remoteKeysChoice"
                            style="@style/SettingsRow"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/remote_key_add" />

                        <TextView
                            style="@style/SettingsFootnote"
                            android:layout_marginBottom="22dp"
                            android:text="@string/remote_mapper_desc" />

                        <TextView
                            android:id="@+id/mappedKeysHeader"
                            style="@style/SettingsGroupLabel"
                            android:layout_marginBottom="10dp"
                            android:text="@string/mapped_keys_header" />

                        <LinearLayout
                            android:id="@+id/mappedKeysList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </ScrollView>

                <!-- PANE 4: Apps & System -->
                <ScrollView
                    android:id="@+id/paneAppsSystem"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsGroupLabel"
                            android:text="APPLICATION MANAGEMENT" />

                        <TextView
                            android:id="@+id/hiddenAppsChoice"
                            style="@style/SettingsRow"
                            android:layout_marginTop="8dp" />

                        <TextView
                            style="@style/SettingsGroupLabel"
                            android:layout_marginTop="24dp"
                            android:text="SYSTEM SHORTCUTS" />

                        <TextView
                            android:id="@+id/defaultHomeChoice"
                            style="@style/SettingsRow"
                            android:layout_marginTop="8dp"
                            android:text="@string/home_settings" />
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Liquid Glass Modal Dialog Overlay (Replaces Android AlertDialog) -->
    <FrameLayout
        android:id="@+id/modalOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="28dp"
            android:background="@drawable/settings_glass_card"
            android:orientation="vertical"
            android:elevation="16dp">

            <TextView
                android:id="@+id/modalTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tvos_label_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/modalSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tvos_label_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="340dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/modalItemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/modalCancelButton"
                style="@style/SettingsRow"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@android:string/cancel" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
