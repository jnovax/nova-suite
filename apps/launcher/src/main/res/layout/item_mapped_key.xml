<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/settings_choice_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:focusable="true"
    android:clickable="true"
    android:stateListAnimator="@animator/tvos_focus_control">

    <TextView
        android:id="@+id/keyBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/key_badge_bg"
        android:duplicateParentState="true"
        android:textColor="@drawable/key_badge_text"
        android:textSize="12sp"
        android:fontFamily="sans-serif-bold"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginEnd="12dp" />

    <TextView
        android:id="@+id/keyTarget"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:textColor="@drawable/pill_text"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/keyChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textColor="@drawable/settings_row_chevron_text"
        android:textSize="16sp"
        android:fontFamily="sans-serif-bold"
        android:layout_marginStart="8dp"
        android:text="›" />
</LinearLayout>
